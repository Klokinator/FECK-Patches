// ExtendWeaponDescBox for FE6: Vesly's FE8 patch, ported by FECK. See Notes.txt.
// The .dmp files are the .s files assembled (arm-none-eabi-as -mthumb, then objcopy -O binary); the game's
// addresses are in Addresses.inc.

#include "EAstdlib.event"

#ifndef callHackNew
	#define callHackNew(offset) "BYTE $01 $4B $9E $46 $00 $F8 $01 $E0; POIN (offset|0x1)"
#endif

ALIGN 4
InitWepDescTextHandles:
#incbin "InitWepDescTextHandles.dmp"

ALIGN 4
YPosDescBox:
#incbin "YPosDescBox.dmp"

ALIGN 4
ClearHelpBoxRows:
#incbin "ClearHelpBoxRows.dmp"

ALIGN 4
InitProcTextHandles:
#incbin "InitProcTextHandles.dmp"

ALIGN 4
HelpTextNewLine:
#incbin "HelpTextNewLine.dmp"

ALIGN 4
StatScreenHelpGfx:
#incbin "StatScreenHelpGfx.dmp"

PUSH

// LoadDialogueBoxGfx: text handles for rows 4 and 5.
ORG $70EAC
callHackNew(InitWepDescTextHandles)
PROTECT $70EAC $70EAC+12

// The help box's y never above the screen.
ORG $7058C
callHackNew(YPosDescBox)
PROTECT $7058C $7058C+12

// ClearHelpBoxText: rows 4 and 5 cleared when the box takes them.
ORG $71522
SHORT $46C0
callHackNew(ClearHelpBoxRows)
SHORT $46C0 $46C0 $46C0
PROTECT $71522 $71522+20

// The help text proc's start: the text handles of rows 4 and 5.
ORG $71468
callHackNew(InitProcTextHandles)
PROTECT $71468 $71468+12

// HelpBoxTextScroll's new line: ends the text on a row with no text handle.
ORG $712CC
BYTE $00 $4A $10 $47; POIN (HelpTextNewLine|0x1)
PROTECT $712CC $712CC+8

// DisplayHelpBoxObj: at most 5 rows (0x50 px) instead of 3.
ORG $70F90
BYTE $50
ORG $70F94
BYTE $50

// The stat screen's help: its box's graphics at 0x6011000, clear of the stat screen's own sprites.
ORG $70310
callHackNew(StatScreenHelpGfx)
PROTECT $70310 $70310+12

POP
